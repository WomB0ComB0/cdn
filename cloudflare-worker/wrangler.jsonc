{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cdn-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // R2 bucket binding (matches CLOUDFLARE_R2_BUCKET=cdn in api.mikeodnis.dev)
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "cdn"
    }
  ],
  // Native Cloudflare Edge Rate Limiting bindings (per-tier protection)
  "ratelimits": [
    {
      "name": "RATE_LIMIT_ASSETS",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_IMG",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_PRIVATE",
      "namespace_id": "1003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  // Non-secret environment variables
  "vars": {
    "R2_BUCKET_NAME": "cdn",
    "IMGPROXY_URL": "https://img.mikeodnis.dev",
    "CACHE_TTL_IMMUTABLE": "31536000",
    "CACHE_TTL_PRIVATE": "3600"
  }
  // Secrets (set via: bunx wrangler secret put SIGNING_SECRET)
  // Once mikeodnis.dev DNS zone is on Cloudflare, attach the custom domain:
  // "routes": [{ "pattern": "cdn.mikeodnis.dev", "custom_domain": true }]
}
