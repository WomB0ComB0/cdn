# Cloudflare R2 Storage (used by scripts/upload-to-r2.js and optional imgproxy)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=cdn
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Shared HMAC-SHA256 Signing Secret (must match api.mikeodnis.dev SIGNING_SECRET)
# Also set on the Worker via: bunx wrangler secret put SIGNING_SECRET
SIGNING_SECRET=your-signing-secret-here

# Cloudflare API Token (optional: CI/CD wrangler deploy via GitHub Actions)
CLOUDFLARE_API_TOKEN=

# Optional imgproxy (for /img/* transforms via docker compose up)
IMGPROXY_KEY=
IMGPROXY_SALT=
